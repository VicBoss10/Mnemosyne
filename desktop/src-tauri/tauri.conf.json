{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mnemosyne",
  "version": "0.1.0",
  "identifier": "com.mnemosyne.desktop",
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "npm run prepare:deps"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "msi", "nsis"],
    "resources": {
      "../binaries/mnemosyne-api": "mnemosyne-api",
      "../binaries/qdrant": "qdrant"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
