# Overrides opcionales. Copiar a .env y ajustar según el entorno.
# El formato es MNEMOSYNE_<seccion>__<clave>.

# Dentro de docker-compose los servicios se ven por nombre, no por localhost:
# MNEMOSYNE_QDRANT__URL=http://qdrant:6333
# MNEMOSYNE_OLLAMA__URL=http://ollama:11434

# Apuntar el motor a tus propios documentos sin tocar config.yaml. El nombre
# del proyecto da nombre a la colección, así que varios pueden convivir en el
# mismo Qdrant. Este archivo (.env) está en .gitignore: es el sitio para la
# configuración local que no debe subirse.
# MNEMOSYNE_PROJECT__NAME=mi-proyecto
# MNEMOSYNE_PROJECT__DOCS_PATH=/ruta/absoluta/a/mis/documentos

# Con más VRAM disponible, un modelo más capaz:
# MNEMOSYNE_OLLAMA__GENERATION_MODEL=llama3.1:8b
