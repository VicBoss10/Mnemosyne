__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.env
qdrant_storage/
ollama_data/
# Almacenamiento que Qdrant crea al correr la app en desarrollo.
desktop/src-tauri/storage/

# Los documentos son datos del usuario, no del motor: pueden ser grandes,
# contener información personal, y cambian sin relación con el código. El motor
# es agnóstico de dominio y el repositorio no lleva ningún corpus.
# La ruta se configura en config.yaml (project.docs_path).
documents/
examples/

# Archivos temporales de herramientas locales
.claude/settings.local.json
.claude/*.tmp.*

# Marcador que Qdrant deja al arrancar desde el directorio del proyecto.
.qdrant-initialized

# Directorio de datos que la API crea al correr desde el repo: dentro vive el
# registro de proyectos, que son datos del usuario igual que sus documentos.
.mnemosyne/
